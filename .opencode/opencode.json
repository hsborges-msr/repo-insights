{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "model": "github-copilot/gpt-5-mini",
  "default_agent": "plan",
  "instructions": ["AGENTS.md", ".opencode/rules/*.md"],
  "formatter": {
    "biome": {
      "disabled": false,
      "command": ["npx", "biome", "format", "--write", "$FILE"]
    }
  },
  "autoupdate": true
}
