# Development defaults, loaded automatically by `next dev`.
# Override locally (and keep secrets) in `.env.development.local`, which is git-ignored.

# --- Browser (required, validated in src/helpers/env/browser.ts) ---

# Public URL of the app, used for metadata/OpenGraph links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Analytics measurement id (leave empty to not track anything meaningful in development)
NEXT_PUBLIC_GA_ID=

# GitHub OAuth App client id, used by the "Sign in" button.
# Sign-in (and therefore GitHub API access) only works with a real OAuth App:
#   https://github.com/settings/developers -> New OAuth App
#   Homepage URL: http://localhost:3000 | Authorization callback URL: http://localhost:3000
NEXT_PUBLIC_GH_CLIENT_ID=Ov23liKp703REe9hRepX

# --- Server (optional, validated in src/helpers/env/local.ts) ---

# Same OAuth App credentials, used by /api/auth/github/access_token to exchange the OAuth code.
# Put GH_CLIENT_SECRET in `.env.development.local`, never in this file.
GH_CLIENT_ID=${NEXT_PUBLIC_GH_CLIENT_ID}
GH_CLIENT_SECRET=
